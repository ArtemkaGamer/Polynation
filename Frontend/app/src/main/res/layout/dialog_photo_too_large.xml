<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_card_white_rounded"
    android:padding="28dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp">

        <View
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_icon_circle_orange" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="!"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="#BA5C32" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Не удалось загрузить фото"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:textColor="#0A1F2D"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Размер фотографии должен быть меньше 12 МБ. Выберите другую и попробуйте загрузить снова."
        android:textSize="13sp"
        android:fontFamily="sans-serif"
        android:textColor="#0A1F2D"
        android:alpha="0.65"
        android:gravity="center"
        android:layout_marginBottom="22dp" />

    <Button
        android:id="@+id/btn_photo_choose_another"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Выбрать другую"
        android:textSize="14sp"
        android:textAllCaps="false"
        android:background="@drawable/btn_primary_orange"
        android:textColor="#FEF9E7"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btn_photo_dismiss"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Закрыть"
        android:textSize="14sp"
        android:textAllCaps="false"
        android:background="@drawable/btn_outline_dark"
        android:textColor="#0A1F2D" />

</LinearLayout>
