<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/user_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_white_rounded"
        android:elevation="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/user_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="end"
                android:layout_margin="12dp"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="#9A8C7A" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_dark_rounded"
                    android:padding="22dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:id="@+id/user_wreath_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:clipChildren="false"
                            android:gravity="end" />

                        <FrameLayout
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp">

                            <View
                                android:layout_width="84dp"
                                android:layout_height="84dp"
                                android:background="@drawable/bg_avatar_ring" />

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_profile_active"
                                app:tint="#BA5C32" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/user_wreath_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:clipChildren="false"
                            android:gravity="start" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FEF9E7"
                        android:layout_marginTop="14dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_joined_pill"
                        android:paddingStart="11dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_marginTop="10dp">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="#FFCDA8"
                            android:layout_marginEnd="7dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/user_joined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Игрок PolyNation"
                            android:textSize="12.5sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#FFCDA8" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card_bezwhite_rounded"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp">

                            <View
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_icon_circle_orange" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_trophy_active"
                                app:tint="#FF7A45" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/user_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#FF7A45"
                            android:layout_marginTop="7dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="очки"
                            android:textSize="11.5sp"
                            android:fontFamily="sans-serif"
                            android:textColor="#9A8C7A"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card_bezwhite_rounded"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp">

                            <View
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_icon_circle_green" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_check_circle" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/user_visited_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#16A34A"
                            android:layout_marginTop="7dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="страны"
                            android:textSize="11.5sp"
                            android:fontFamily="sans-serif"
                            android:textColor="#9A8C7A"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card_bezwhite_rounded"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp">

                            <View
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_icon_circle_brown" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_ach_medal"
                                app:tint="#BA5C32" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/user_achievements_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#BA5C32"
                            android:layout_marginTop="7dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ачивки"
                            android:textSize="11.5sp"
                            android:fontFamily="sans-serif"
                            android:textColor="#9A8C7A"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_bezwhite_rounded"
                    android:padding="18dp"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_section_accent" />

                        <TextView
                            android:id="@+id/user_achievements_title"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Достижения"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#1B261F" />

                        <TextView
                            android:id="@+id/user_achievements_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 / 13"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#BA5C32" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/user_progress_achievements"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="13"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_achievement"
                        android:layout_marginTop="14dp" />

                    <TextView
                        android:id="@+id/user_achievements_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Пока нет ачивок"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif"
                        android:textColor="#9A8C7A"
                        android:visibility="gone"
                        android:layout_marginTop="10dp" />

                    <LinearLayout
                        android:id="@+id/user_achievements_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_bezwhite_rounded"
                    android:padding="18dp"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_section_accent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Страны, где был"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#1B261F" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/user_visited_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Загрузка..."
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif"
                        android:textColor="#1B261F"
                        android:alpha="0.7"
                        android:layout_marginTop="10dp" />

                    <LinearLayout
                        android:id="@+id/user_visited_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
