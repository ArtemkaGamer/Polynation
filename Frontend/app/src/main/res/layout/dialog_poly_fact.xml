<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:clipToPadding="false"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/fact_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_white_rounded"
        android:padding="22dp"
        android:elevation="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_assistant_badge" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_poly"
                    android:contentDescription="Поли" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Поли"
                android:textColor="#1B261F"
                android:textStyle="bold"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium" />

            <ImageButton
                android:id="@+id/fact_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="#BA5C32"
                android:contentDescription="Закрыть" />
        </LinearLayout>

        <TextView
            android:id="@+id/fact_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="А ты знал, что?"
            android:textColor="#BA5C32"
            android:textStyle="bold"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/fact_flag"
                android:layout_width="76dp"
                android:layout_height="50dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.PolyNation.Flag"
                app:strokeColor="#22BA5C32"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/fact_country"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:textColor="#1B261F"
                android:textStyle="bold"
                android:textSize="19sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <TextView
            android:id="@+id/fact_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_capital_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="#BA5C32"
            android:textStyle="bold"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/fact_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#3A3026"
            android:textSize="14.5sp"
            android:lineHeight="22sp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/fact_photo"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="16dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.PolyNation.Flag"
            app:strokeColor="#22BA5C32"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/fact_ok"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:text="Здорово!"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:background="@drawable/btn_primary_orange"
            android:textColor="#FEF9E7" />
    </LinearLayout>
</ScrollView>
