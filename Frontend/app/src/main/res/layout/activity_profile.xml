<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FEF9E7">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_navigation_layout"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Профиль"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#1B261F" />

                <Button
                    android:id="@+id/btn_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Редактировать"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_outline_dark"
                    android:textColor="#0A1F2D" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_dark_rounded"
                android:padding="26dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="3dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:id="@+id/container_wreath_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:gravity="end" />

                    <FrameLayout
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp">

                        <View
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:background="@drawable/bg_avatar_ring" />

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_profile_active"
                            app:tint="#BA5C32" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/container_wreath_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:gravity="start" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Загрузка..."
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FEF9E7"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/tv_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:textSize="14sp"
                    android:fontFamily="sans-serif"
                    android:textColor="#FEF9E7"
                    android:alpha="0.6"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="В PolyNation с "
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif"
                        android:textColor="#FEF9E7"
                        android:alpha="0.5" />

                    <TextView
                        android:id="@+id/tv_joined_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="..."
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFCDA8" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_stats_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_white_rounded"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:elevation="2dp">

                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp">

                        <View
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_icon_circle_orange" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_trophy_active"
                            app:tint="#FF7A45" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FF7A45"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="очки"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:textColor="#9A8C7A"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_white_rounded"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:elevation="2dp">

                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp">

                        <View
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_icon_circle_brown" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_quizzes_active"
                            app:tint="#BA5C32" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_quizzes_solved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#BA5C32"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="квизы"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:textColor="#9A8C7A"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_white_rounded"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:elevation="2dp">

                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp">

                        <View
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_icon_circle_green" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_check_circle" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_visited_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#16A34A"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="страны"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:textColor="#9A8C7A"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_white_rounded"
                android:padding="20dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_section_accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Достижения"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#1B261F" />

                    <TextView
                        android:id="@+id/tv_achievements_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 13"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#BA5C32" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress_achievements"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="13"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_achievement"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/tv_achievements_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Решайте квизы, отмечайте страны и набирайте очки, чтобы открывать достижения"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif"
                    android:textColor="#9A8C7A"
                    android:lineSpacingExtra="1dp"
                    android:layout_marginTop="10dp" />

                <LinearLayout
                    android:id="@+id/container_achievements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_edit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_white_rounded"
                android:padding="20dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_section_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Имя пользователя"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#1B261F" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_username"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:textColor="#1B261F"
                    android:textColorHint="#999999"
                    android:hint="Введите новое имя"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:background="@drawable/edit_background_light"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_save_name"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="Сохранить имя"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_primary_orange"
                    android:textColor="#FEF9E7" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_white_rounded"
                android:padding="20dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_section_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Страны, где я был"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#1B261F" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_visited_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Нажмите «Редактировать», чтобы удалить страну"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:textColor="#BA5C32"
                    android:visibility="gone"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tv_visited_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Загрузка..."
                    android:textSize="14sp"
                    android:fontFamily="sans-serif"
                    android:textColor="#1B261F"
                    android:alpha="0.7"
                    android:paddingTop="10dp" />

                <LinearLayout
                    android:id="@+id/container_visited_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_white_rounded"
                android:padding="20dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_section_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Моя галерея"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#1B261F" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_gallery_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Добавляйте фотографии посещённых мест на карте — они появятся здесь"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:textColor="#9A8C7A"
                    android:lineSpacingExtra="1dp"
                    android:layout_marginTop="10dp" />

                <LinearLayout
                    android:id="@+id/container_gallery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Выйти"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:background="@drawable/btn_outline_dark"
                android:textColor="#0A1F2D"
                android:layout_marginBottom="24dp" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottom_navigation_layout"
        layout="@layout/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />
</RelativeLayout>
