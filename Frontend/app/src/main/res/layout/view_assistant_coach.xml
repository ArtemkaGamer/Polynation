<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/coach_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginHorizontal="18dp"
    android:layout_marginBottom="94dp"
    android:orientation="vertical"
    android:background="@drawable/bg_assistant_bubble"
    android:padding="20dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="26dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/coach_avatar"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_assistant_badge" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_poly"
                android:contentDescription="Поли" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Поли"
            android:textColor="#FEF9E7"
            android:textStyle="bold"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/coach_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#EAF1F5"
        android:textSize="14sp"
        android:lineHeight="21sp" />

    <LinearLayout
        android:id="@+id/coach_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="18dp"
        android:clipChildren="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">

        <ImageButton
            android:id="@+id/coach_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_coach_prev"
            android:scaleType="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/coach_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Пропустить"
            android:textColor="#9FB3BD"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <Button
            android:id="@+id/coach_next"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="14dp"
            android:text="Далее"
            android:textColor="#FEF9E7"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:drawableEnd="@drawable/ic_coach_fwd"
            android:drawablePadding="4dp"
            android:background="@drawable/btn_primary_orange" />
    </LinearLayout>
</LinearLayout>
