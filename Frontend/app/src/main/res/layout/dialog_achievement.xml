<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="28dp">

    <LinearLayout
        android:id="@+id/ach_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_card_white_rounded"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="22dp"
        android:paddingBottom="24dp"
        android:elevation="8dp">

        <TextView
            android:id="@+id/ach_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Новое достижение!"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:fontFamily="sans-serif-medium"
            android:textColor="#BA5C32"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <FrameLayout
            android:id="@+id/ach_medallion_holder"
            android:layout_width="104dp"
            android:layout_height="104dp" />

        <TextView
            android:id="@+id/ach_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:textColor="#1B261F"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/ach_tier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_question_pill"
            android:textColor="#BA5C32"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/ach_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14.5sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:fontFamily="sans-serif"
            android:textColor="#5A5247"
            android:layout_marginTop="14dp" />

        <ProgressBar
            android:id="@+id/ach_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_achievement"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/ach_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="#16A34A"
            android:visibility="gone"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/ach_ok"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Отлично"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:background="@drawable/btn_primary_orange"
            android:textColor="#FEF9E7"
            android:layout_marginTop="22dp" />
    </LinearLayout>
</FrameLayout>
