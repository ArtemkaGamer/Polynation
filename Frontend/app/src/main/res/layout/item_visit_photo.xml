<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#F2E8DA"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.PolyNation.Flag"
        app:strokeColor="#22BA5C32"
        app:strokeWidth="1dp" />

    <ImageView
        android:id="@+id/btn_delete_photo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_delete_circle"
        android:padding="8dp"
        android:src="@drawable/ic_close"
        android:contentDescription="Удалить фото"
        android:visibility="gone"
        app:tint="#DC2626" />
</FrameLayout>
